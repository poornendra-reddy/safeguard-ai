# ==============================================================================
# SAFEGUARD AI — Environment Configuration Template
# Copy this file to .env.local for local development.
# On Vercel, configure these variables in Settings -> Environment Variables.
# ==============================================================================

# Project Metadata
PROJECT_NAME="SAFEGUARD AI"
ENVIRONMENT="production"
VERSION="2.4.0"

# CORS Allowed Origins (Comma-separated)
# Leave wildcard or specify your Vercel domain e.g. https://safeguard-ai.vercel.app
ALLOWED_ORIGINS="*"

# Optional Third-Party Security & Threat Intelligence API Keys
# (Safeguard AI includes zero-dependency local heuristic cyber engines that function 100% without external keys)
VIRUSTOTAL_API_KEY=""
GOOGLE_SAFE_BROWSING_KEY=""
ABUSEIPDB_API_KEY=""

# Network & Upload Thresholds
MAX_UPLOAD_SIZE_BYTES=10485760
REQUEST_TIMEOUT_SECONDS=15.0

# Frontend Backend Resolution
# On Vercel same-origin deployments, defaults to relative /api/py
NEXT_PUBLIC_API_URL="/api/py"
